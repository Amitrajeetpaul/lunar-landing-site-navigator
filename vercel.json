{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/pgda/:file", "destination": "/api/nasa?src=pgda&file=:file" },
    { "source": "/imbrium/:file", "destination": "/api/nasa?src=imbrium&file=:file" },
    { "source": "/horizons", "destination": "/api/nasa?src=horizons" }
  ]
}
